# Supabase Database (or local SQLite fallback)
# For Supabase, use: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite+aiosqlite:///./sachai.db
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cache
REDIS_URL=redis://localhost:6379/0

# AI & Fact-Check APIs
GEMINI_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=
SEARCH_API_KEY=
SEARCH_PROVIDER=duckduckgo

# Security & Auth
AUTH_SECRET=sachai-super-secret-key-change-in-production-min-32-chars-long

# Object Storage (Supabase Storage / S3 / Cloudflare R2)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
